# Production environment for the combined Docker deployment (see
# Dockerfile / docker-compose.yml). Copy to .env.production on the Pi and
# fill in the real values — that file is never committed (see .gitignore).

APP_PORT=5000
APP_ENV=production
APP_NAME=pidrive

# The already-running Postgres container, reached via its host-published
# address (see the `postgres` service's `ports:` in its own compose file) —
# not a Docker network, since the two containers aren't on one.
DATABASE_URL=postgresql://<user>:<password>@100.83.1.25:5432/<database>

# Generate fresh secrets for production — do not reuse the ones in backend/.env.
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=<64-char-random-string>
JWT_REFRESH_SECRET=<64-char-random-string>
JWT_ISSUER=pidrive
JWT_AUDIENCE=pidrive-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# Secure cookies: correct even though cloudflared talks to the container over
# plain HTTP — the browser's connection to Cloudflare's edge is HTTPS, which
# is what the Secure flag actually checks.
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# Mostly moot in production (frontend and API are same-origin, served by the
# one container), but validated at boot and useful if you ever call the API
# directly from a different origin. Set to your real domain.
CORS_ORIGINS=https://your-domain.example
